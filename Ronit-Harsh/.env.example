# Backend Server Settings
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Service Authentication
# Placed here for legacy scripts; server.py relies largely on `credentials.json` directly.
GOOGLE_CLIENT_SECRETS=./credentials/client_secrets.json
GOOGLE_TOKEN_PATH=./token.json
GMAIL_QUERY=

# AI & Additional Features
MISTRAL_API_KEY=your_mistral_api_key
AIMS_ENCRYPTION_KEY='your_aims_encryption_key'
CHROMADB_PATH=./chroma_db